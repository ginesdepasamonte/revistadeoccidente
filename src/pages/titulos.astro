---
import DirectoryHeader from "../components/DirectoryHeader.astro";
import IndexSearch from "../components/IndexSearch.astro";
import SiteFooter from "../components/SiteFooter.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { indexLetter, pageLabel, titles } from "../lib/archive-index";
import { baseUrl } from "../lib/site";
const letters = [...new Set(titles.map((entry) => indexLetter(entry.title)))];
const groups = letters.map((letter) => ({
  letter,
  titles: titles.filter((entry) => indexLetter(entry.title) === letter),
}));
---

<BaseLayout
  title="Índice de títulos — Revista de Occidente"
  description="Buscador e índice alfabético de títulos publicados en la primera época de Revista de Occidente, entre 1923 y 1936."
  active="titles"
  skipHref="#titles-index"
  skipLabel="Ir al índice de títulos"
>
  <DirectoryHeader
    eyebrow="Archivo bibliográfico · Títulos"
    title="Índice de títulos"
    description="Las contribuciones de la primera época ordenadas alfabéticamente. Busque por título o por el nombre de un autor."
  />

  <main class="directory-main directory-main--searchable" id="titles-index">
    <IndexSearch
      id="title-search"
      targetId="title-groups"
      label="Buscar títulos"
      placeholder="Título o autor…"
      total={titles.length}
      singular="título"
      plural="títulos"
    />

    <nav class="directory-jump-nav directory-jump-nav--letters" aria-label="Ir a una letra">
      <span>Inicial</span>
      <div>
        {letters.map((letter) => <a href={`#titulos-${letter === "#" ? "otros" : letter.toLowerCase()}`}>{letter}</a>)}
      </div>
    </nav>

    <div class="letter-groups" id="title-groups">
      {groups.map((group) => {
        const groupId = group.letter === "#" ? "otros" : group.letter.toLowerCase();
        return (
          <section
            class="letter-group letter-group--titles"
            id={`titulos-${groupId}`}
            aria-labelledby={`titulos-heading-${groupId}`}
            data-search-group
          >
            <header class="letter-group__heading">
              <h2 id={`titulos-heading-${groupId}`}>{group.letter}</h2>
              <p>{group.titles.length} títulos</p>
            </header>

            <ol class="title-list">
              {group.titles.map((entry) => {
                const pages = pageLabel(entry.pageStart, entry.pageEnd);
                return (
                  <li
                    data-search-item
                    data-search-text={`${entry.title} ${entry.authors.join(" ")}`}
                  >
                    <div class="title-entry__work">
                      <cite>{entry.title}</cite>
                      {entry.authors.length > 0 && (
                        <p>
                          {entry.authors.map((author, index) => (
                            <>
                              {index > 0 && ", "}
                              <a href={`${baseUrl}autores/?q=${encodeURIComponent(author)}`}>{author}</a>
                            </>
                          ))}
                        </p>
                      )}
                    </div>
                    <div class="title-entry__issue">
                      <a href={`${baseUrl}indice/#numero-${entry.issueNumber}`}>N.º {entry.issueNumber}</a>
                      <span>{entry.month} de {entry.year}</span>
                    </div>
                    <span class="title-entry__pages">{pages}</span>
                  </li>
                );
              })}
            </ol>
          </section>
        );
      })}
    </div>

    <aside class="source-note">
      <h2>Criterio de ordenación</h2>
      <p>
        Los títulos se conservan como aparecen en la fuente y se ordenan sin distinguir
        mayúsculas ni acentos. Los signos iniciales se agrupan bajo «#».
      </p>
    </aside>
  </main>

  <SiteFooter />
</BaseLayout>
